    <string name="shield_rule_direct_single_reel_body">Un reel reçu en discussion se lance ; passer au suivant te ramène en arrière</string>
    <string name="shield_rule_other_reels">Reels ouverts ailleurs</string>
    <string name="shield_rule_other_reels_body">Reels ouverts depuis le fil, les notifications ou la recherche</string>
