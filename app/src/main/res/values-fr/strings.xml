    <string name="shield_rule_explore_grid">Grille Explorer</string>
    <string name="shield_rule_explore_grid_body">Publications et reels suggérés masqués ; la barre de recherche reste utilisable</string>
    <string name="shield_rule_search_accounts_only">Recherche : comptes uniquement</string>
    <string name="shield_rule_search_accounts_only_body">Les résultats de recherche s\'ouvrent toujours sur l\'onglet Comptes</string>
    <string name="shield_rule_home_feed">Fil d\'accueil</string>
    <string name="shield_rule_home_feed_body">Le fil est masqué ; les stories restent visibles</string>
    <string name="shield_rule_stories">Stories</string>
    <string name="shield_rule_stories_body">Ouvrir une story te ramène en arrière</string>
    <string name="shield_disable_title">Désactiver cette protection ?</string>
    <string name="shield_disable_body">Respire un coup. Si l\'envie est toujours là dans quelques secondes, tu pourras confirmer.</string>
    <string name="shield_disable_wait">Attends %1$d s</string>
    <string name="shield_disable_confirm">Désactiver</string>
    <string name="shield_disclosure_title">Avant d\'activer</string>
    <string name="shield_disclosure_body">Clairjour utilise le service d\'accessibilité d\'Android pour reconnaître les écrans d\'Instagram (Reels, Explorer, recherche, discussions) et, à ta place, revenir en arrière, toucher l\'onglet Comptes ou masquer une zone.\n\n• Seul l\'écran d\'Instagram est lu ; les autres apps sont ignorées.\n• Tout se passe sur ton téléphone : rien n\'est enregistré, collecté ni envoyé.\n• Tu peux le couper à tout moment dans les réglages d\'accessibilité d\'Android.\n\nSur l\'écran suivant, choisis « Clairjour — Bouclier Instagram » et active-le.</string>
    <string name="shield_disclosure_accept">J\'accepte</string>
    <string name="shield_disclosure_decline">Plus tard</string>
